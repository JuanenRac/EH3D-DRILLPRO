{
  "repo": "EH3D-DRILLPRO",
  "ecosystem": "eh3d",
  "tagline": "The drilling workflow of a classic DOS program for Bungard CCD machines, in Rust.",
  "description": "EH3D-DRILLPRO reads Excellon drill files, the tool table and the machine file, orders the holes and runs the job through its classic or modern text-mode screens. The job goes to a simulator, to the serial port or a USB adapter, to the EH3D-NODE-BUNGARD node or to EH3D-SERVER. EH3D-ROUTEPRO reuses its protocol, screens and languages. Everything is tested on a computer; on one real machine only the reference run and the moves of each axis have been tried.",
  "columns": [
    "WHO USES IT",
    "THIS REPOSITORY",
    "WHERE THE JOB GOES"
  ],
  "nodes": [
    {
      "id": "op",
      "column": 0,
      "level": "external",
      "title": "The operator",
      "lines": [
        "keyboard and mouse, in a window",
        "or in a terminal (SSH, a text",
        "console, an old PC)"
      ]
    },
    {
      "id": "files",
      "column": 0,
      "level": "external",
      "title": "Drill files",
      "lines": [
        "Excellon .NCD, the tool table",
        "DRILLPRO.DTD and the machine",
        "file DRILLPRO.DCF"
      ]
    },
    {
      "id": "route",
      "column": 0,
      "level": "external",
      "title": "EH3D-ROUTEPRO",
      "lines": [
